# Настройки бота Telegram
# Чтобы получить айди чата можно использовать: https://t.me/username_to_id_bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Настройка топиков Telegram для посылки уведомлений
# Чтобы получить айди топика - скопируйте ссылку на сообщение.
# Пример: https://t.me/c/123123123/[2]/21 - 2 это и есть айди топика.

# Пользователи: создан, изменен, продлен, истек, лимит трафика
TOPIC_USER=
# Ноды: создана, включена/выключена, потеря/восстановление связи, трафик
TOPIC_NODE=
# Сервис: запуск панели, входы в панель, API-токены
TOPIC_SERVICE=
# Ошибки: превышен лимит уведомлений и прочие сбои (если пусто - используется TOPIC_SERVICE)
TOPIC_ERRORS=
# Системные статусы бота: сводки падений нод, ежедневная статистика пользователей
TOPIC_STATUS=
# Отчеты торрент-блокировщика: обнаружен торрент-трафик (если пусто - используется TOPIC_NODE)
TOPIC_TORRENT_BLOCKER=
# Устройства HWID: добавлено/удалено устройство (если пусто - используется TOPIC_USER)
TOPIC_USER_HWID_DEVICES=
# Биллинг нод: напоминания об оплате и просрочке
TOPIC_CRM=

# Настройки вебхука
WEBHOOK_SECRET_HEADER=your_webhook_secret_here
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8089
WEBHOOK_PATH=/

# Выбор языка (ru, en)
LANGUAGE=ru
LOCALES_DIR=locales

# Таймзона для отображения времени (UTC, Europe/Moscow, Europe/Samara, Asia/Yekaterinburg итд)
# Зоны: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Moscow

# Формат отображения времени (по умолчанию: %d.%m.%Y %H:%M:%S)
# %d.%m.%Y %H:%M:%S = 01.11.2025 23:04:10
# %Y-%m-%d %H:%M:%S = 2025-11-01 23:04:10
TIME_FORMAT="%d.%m.%Y %H:%M:%S"

# Сервис подсчета и вывода последних упавших нод (вывод в топик TOPIC_STATUS)
ENABLE_CONNECTION_LOSS_STATS=false
# Время хранения метрик падений в часах (по умолчанию: 24)
CONNECTION_LOSS_STATS_HOURS=24
# Интервал отправки отчетов о потерях соединения в часах (по умолчанию: 3)
CONNECTION_LOSS_REPORT_INTERVAL_HOURS=3

# Сервис ежедневной статистики user.created и user.first_connected пользователей (вывод в топик TOPIC_STATUS)
ENABLE_USER_DAILY_STATS=false
# Время отправки отчета в формате HH:MM (по умолчанию: 00:00)
USER_DAILY_STATS_TIME=00:00

# User (https://docs.rw/docs/features/webhooks#user)
NOTIFY_USER_CREATED=true
NOTIFY_USER_MODIFIED=true
NOTIFY_USER_DELETED=true
NOTIFY_USER_REVOKED=true
NOTIFY_USER_DISABLED=true
NOTIFY_USER_ENABLED=true
NOTIFY_USER_LIMITED=true
NOTIFY_USER_EXPIRED=true
NOTIFY_USER_TRAFFIC_RESET=true
NOTIFY_USER_FIRST_CONNECTED=true
NOTIFY_USER_BANDWIDTH_USAGE_THRESHOLD_REACHED=true
# Требует NOT_CONNECTED_USERS_NOTIFICATIONS_ENABLED=true в .env панели
NOTIFY_USER_NOT_CONNECTED=true
# Требует EXPIRATION_NOTIFICATIONS_ENABLED=true в .env панели
NOTIFY_USER_EXPIRATION=true

# User HWID devices (https://docs.rw/docs/features/webhooks#user_hwid_devices)
NOTIFY_USER_HWID_DEVICES_ADDED=true
NOTIFY_USER_HWID_DEVICES_DELETED=true

# Node (https://docs.rw/docs/features/webhooks#node)
NOTIFY_NODE_CREATED=true
NOTIFY_NODE_MODIFIED=true
NOTIFY_NODE_DISABLED=true
NOTIFY_NODE_ENABLED=true
NOTIFY_NODE_DELETED=true
NOTIFY_NODE_CONNECTION_LOST=true
NOTIFY_NODE_CONNECTION_RESTORED=true
NOTIFY_NODE_TRAFFIC_NOTIFY=true

# Billing (https://docs.rw/docs/features/webhooks#node-infra-billing)
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_IN_7_DAYS=true
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_IN_48HRS=true
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_IN_24HRS=true
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_DUE_TODAY=true
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_OVERDUE_24HRS=true
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_OVERDUE_48HRS=true
NOTIFY_CRM_INFRA_BILLING_NODE_PAYMENT_OVERDUE_7_DAYS=true

# Service (https://docs.rw/docs/features/webhooks#service)
NOTIFY_SERVICE_PANEL_STARTED=true
NOTIFY_SERVICE_LOGIN_ATTEMPT_SUCCESS=true
NOTIFY_SERVICE_LOGIN_ATTEMPT_FAILED=true
NOTIFY_SERVICE_SUBPAGE_CONFIG_CHANGED=true
NOTIFY_SERVICE_API_TOKEN_CREATED=true
NOTIFY_SERVICE_API_TOKEN_DELETED=true

# Torrent Blocker (https://docs.rw/docs/features/webhooks#torrent_blocker), панель v2.7.0+
NOTIFY_TORRENT_BLOCKER_REPORT=true

# Errors (https://docs.rw/docs/features/webhooks#errors)
NOTIFY_ERRORS_BANDWIDTH_USAGE_THRESHOLD_REACHED_MAX_NOTIFICATIONS=true

# Устаревшие события (заменены на user.expiration)
NOTIFY_USER_EXPIRES_IN_72_HOURS=true
NOTIFY_USER_EXPIRES_IN_48_HOURS=true
NOTIFY_USER_EXPIRES_IN_24_HOURS=true
NOTIFY_USER_EXPIRED_24_HOURS_AGO=true

# Логирование (для разработчиков)
LOG_LEVEL=INFO
LOG_DISABLED_EVENTS=false